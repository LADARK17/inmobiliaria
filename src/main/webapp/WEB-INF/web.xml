<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Sistema Inmobiliario MVC</display-name>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>inicio</welcome-file>
    </welcome-file-list>

    <!-- Manejo de páginas de error HTTP amigables -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/common/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/common/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/common/500.jsp</location>
    </error-page>

    <!-- ═══════════════════════════════════════════════════════════
         FILTROS DE SERVLET
         ═══════════════════════════════════════════════════════════ -->

    <!-- 1. Filtro de codificación UTF-8 (aplica a todas las rutas) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.inmobiliaria.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2. Filtro de autenticación y autorización por rol -->
    <!--    /cliente/* → rol CLIENTE, AGENTE o ADMINISTRADOR       -->
    <!--    /agente/*  → rol AGENTE o ADMINISTRADOR                -->
    <!--    /admin/*   → rol ADMINISTRADOR exclusivamente          -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.inmobiliaria.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/cliente/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/agente/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- ═══════════════════════════════════════════════════════════
         CONFIGURACIÓN DE SESIÓN
         ═══════════════════════════════════════════════════════════ -->

    <!-- Sesión: 30 minutos de inactividad; cookie solo accesible por HTTP -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

</web-app>
