<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<footer class="footer-custom mt-auto">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <h5 class="text-white fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-buildings-fill text-primary"></i> InmoGest.co
                </h5>
                <p class="small text-secondary">
                    Plataforma web académica para administración inmobiliaria integral desarrollada en Java EE (MVC), JSP, JDBC y MySQL bajo metodología Scrum.
                </p>
                <div class="d-flex gap-3 text-white fs-5">
                    <a href="#" class="text-secondary hover-primary"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-secondary hover-primary"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-secondary hover-primary"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
            <div class="col-lg-2 col-md-6">
                <h6 class="text-white fw-semibold mb-3">Navegación</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2"><a href="${pageContext.request.contextPath}/inicio" class="text-secondary text-decoration-none">Inicio</a></li>
                    <li class="mb-2"><a href="${pageContext.request.contextPath}/catalogo" class="text-secondary text-decoration-none">Catálogo</a></li>
                    <li class="mb-2"><a href="${pageContext.request.contextPath}/login" class="text-secondary text-decoration-none">Ingreso Clientes</a></li>
                    <li class="mb-2"><a href="${pageContext.request.contextPath}/registro" class="text-secondary text-decoration-none">Crear Cuenta</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-6">
                <h6 class="text-white fw-semibold mb-3">Credenciales de Demostración</h6>
                <ul class="list-unstyled small text-secondary">
                    <li class="mb-1"><strong>Admin:</strong> admin@inmobiliaria.com / 123456</li>
                    <li class="mb-1"><strong>Agente:</strong> agente.carlos@santander.com / 123456</li>
                    <li class="mb-1"><strong>Cliente:</strong> cliente.juan@gmail.com / 123456</li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-6">
                <h6 class="text-white fw-semibold mb-3">Soporte y Contacto</h6>
                <p class="small text-secondary mb-1"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Bucaramanga, Santander, Colombia</p>
                <p class="small text-secondary mb-1"><i class="bi bi-telephone-fill text-primary me-2"></i>PBX: (607) 635-1000</p>
                <p class="small text-secondary mb-1"><i class="bi bi-envelope-fill text-primary me-2"></i>soporte@inmogest.co</p>
            </div>
        </div>
        <hr class="border-secondary my-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary">
            <p class="mb-0">&copy; 2026 InmoGest. Todos los derechos reservados.</p>
            <p class="mb-0">Arquitectura MVC &bull; Java EE 8 &bull; Apache Tomcat &bull; MySQL 3FN</p>
        </div>
    </div>
</footer>

<!-- Bootstrap 5.3 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Scripts personalizados -->
<script src="${pageContext.request.contextPath}/assets/js/main.js"></script>
</body>
</html>
