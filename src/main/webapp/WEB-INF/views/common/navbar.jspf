<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<nav class="navbar navbar-expand-lg navbar-custom sticky-top">
    <div class="container">
        <!-- Logotipo Principal Hábitat Prime -->
        <a class="navbar-brand brand-logo d-flex align-items-center gap-2" href="${pageContext.request.contextPath}/inicio">
            <div class="brand-icon-box">
                <i class="bi bi-buildings-fill"></i>
            </div>
            <div class="d-flex flex-column lh-1">
                <span class="brand-title">Hábitat<span class="text-primary">Prime</span></span>
                <span class="brand-subtitle">Bienes Raíces</span>
            </div>
        </a>

        <button class="navbar-toggler border-0 shadow-none p-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContenido">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navbarContenido">
            <!-- Enlaces de navegación pública enriquecidos -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 align-items-lg-center gap-1">
                <li class="nav-item">
                    <a class="nav-link ${pageTitle == 'Encuentra tu Inmueble Ideal' ? 'active' : ''}" href="${pageContext.request.contextPath}/inicio">
                        <i class="bi bi-house-door me-1 text-primary"></i> Inicio
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/catalogo?operacion=VENTA">
                        <i class="bi bi-tag-fill me-1 text-success"></i> Comprar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/catalogo?operacion=ARRIENDO">
                        <i class="bi bi-key-fill me-1 text-warning"></i> Arrendar
                    </a>
                </li>
                <!-- Dropdown Menú de Tipos de Inmuebles -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-grid-fill me-1 text-primary"></i> Inmuebles
                    </a>
                    <ul class="dropdown-menu shadow-lg border-0 rounded-3 p-2 mt-1">
                        <li>
                            <a class="dropdown-item py-2 rounded-2 fw-bold text-primary" href="${pageContext.request.contextPath}/catalogo">
                                <i class="bi bi-collection-fill me-2"></i> Ver Catálogo Completo
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item py-2 rounded-2" href="${pageContext.request.contextPath}/catalogo?tipo=1">
                                <i class="bi bi-building me-2 text-info"></i> Apartamentos
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 rounded-2" href="${pageContext.request.contextPath}/catalogo?tipo=2">
                                <i class="bi bi-house-heart me-2 text-success"></i> Casas y Villas
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 rounded-2" href="${pageContext.request.contextPath}/catalogo?tipo=3">
                                <i class="bi bi-briefcase me-2 text-secondary"></i> Oficinas y Locales
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/inicio#carruselInfinitoOuter">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill me-1" style="font-size: 0.7rem; font-weight: 700;">TOP</span> Destacados
                    </a>
                </li>
            </ul>

            <!-- Sección de usuario / acciones -->
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                <c:choose>
                    <c:when test="${not empty sessionScope.usuarioLogueado}">
                        <!-- Acceso directo a paneles según roles del usuario -->
                        <c:forEach var="rol" items="${sessionScope.usuarioLogueado.roles}">
                            <c:if test="${rol.nombre == 'CLIENTE'}">
                                <li class="nav-item">
                                    <a class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1" href="${pageContext.request.contextPath}/cliente/dashboard">
                                        <i class="bi bi-person-workspace"></i> Panel Cliente
                                    </a>
                                </li>
                            </c:if>
                            <c:if test="${rol.nombre == 'AGENTE'}">
                                <li class="nav-item">
                                    <a class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1" href="${pageContext.request.contextPath}/agente/dashboard">
                                        <i class="bi bi-briefcase-fill"></i> Panel Agente
                                    </a>
                                </li>
                            </c:if>
                            <c:if test="${rol.nombre == 'ADMINISTRADOR'}">
                                <li class="nav-item">
                                    <a class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1" href="${pageContext.request.contextPath}/admin/dashboard">
                                        <i class="bi bi-shield-lock-fill"></i> Administración
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1" href="${pageContext.request.contextPath}/admin/propiedades">
                                        <i class="bi bi-houses-fill"></i> Inmuebles
                                    </a>
                                </li>
                            </c:if>
                        </c:forEach>

                        <!-- Menú desplegable de usuario autenticado -->
                        <li class="nav-item dropdown ms-lg-2">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-1 pe-2 rounded-pill bg-light border" href="#" role="button" data-bs-toggle="dropdown">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 34px; height: 34px; font-size: 0.95rem;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="fw-semibold text-dark small">${sessionScope.nombre_usuario}</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2" style="min-width: 240px;">
                                <li class="px-3 py-2 border-bottom mb-2 bg-light rounded-3">
                                    <div class="fw-bold text-dark text-truncate">${sessionScope.nombre_usuario}</div>
                                    <div class="small text-muted text-truncate">${sessionScope.correo_usuario}</div>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 py-2" href="${pageContext.request.contextPath}/cliente/perfil">
                                        <i class="bi bi-person-badge text-primary me-2"></i> Mi Perfil (1:1)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 py-2" href="${pageContext.request.contextPath}/cliente/favoritos">
                                        <i class="bi bi-heart-fill text-danger me-2"></i> Mis Favoritos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 py-2" href="${pageContext.request.contextPath}/cliente/citas">
                                        <i class="bi bi-calendar-check-fill text-success me-2"></i> Mis Citas
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 py-2" href="${pageContext.request.contextPath}/cliente/solicitudes">
                                        <i class="bi bi-file-earmark-text-fill text-info me-2"></i> Mis Solicitudes
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-2"></li>
                                <li>
                                    <a class="dropdown-item text-danger fw-semibold rounded-3 py-2" href="${pageContext.request.contextPath}/logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <!-- Usuario visitante sin sesión activa -->
                        <li class="nav-item">
                            <a class="nav-link fw-semibold px-2" href="${pageContext.request.contextPath}/login">
                                <i class="bi bi-box-arrow-in-right me-1 text-primary"></i> Iniciar Sesión
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-1 fw-bold" href="${pageContext.request.contextPath}/registro">
                                <i class="bi bi-person-plus-fill"></i> Crear Cuenta
                            </a>
                        </li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>
